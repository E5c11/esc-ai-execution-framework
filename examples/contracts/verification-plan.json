{
  "schema_version": 1,
  "task_id": "task-index-review",
  "profiles": ["content/esc-verification-profile.yaml"],
  "strategy": {
    "order": ["focused", "component", "impact", "final"],
    "stop_on_failure": true
  },
  "impact": {
    "graph": "esc-dependencies.json",
    "source_components": ["content"],
    "consumer_components": ["recommendations"]
  },
  "gates": [
    {
      "id": "focused",
      "status": "input-required",
      "checks": [
        {
          "id": "content-focused-tests",
          "command": ["./gradlew", ":content:test", "--tests", "{test_filter}"],
          "requires": ["test_filter"]
        }
      ]
    },
    {
      "id": "component",
      "status": "ready",
      "checks": [{"id": "content-tests", "command": ["./gradlew", ":content:test"]}]
    },
    {
      "id": "impact",
      "status": "ready",
      "checks": [{"id": "recommendations-tests", "command": ["./gradlew", ":recommendations:test"]}]
    },
    {
      "id": "final",
      "status": "ready",
      "checks": [{"id": "repository-tests", "command": ["./gradlew", "test"]}]
    }
  ]
}
